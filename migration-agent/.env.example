# ─────────────────────────────────────────────────────────────
# Angular → React Migration Agent — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Required ───────────────────────────────────────────────
# Your OpenCode / OpenAI-compatible API key
OPENCODE_API_KEY=your-api-key-here

# ─── Optional ───────────────────────────────────────────────
# AI endpoint base URL (default: OpenAI)
# Use this to point to OpenCode, Azure OpenAI, or any compatible endpoint
OPENCODE_BASE_URL=https://api.openai.com/v1

# Model to use for code generation (default: gpt-4o)
# Recommended: gpt-4o or gpt-4-turbo for best code quality
OPENCODE_MODEL=gpt-4o

# Default output directory for generated React app
# MIGRATION_OUTPUT_DIR=./react-salon-app
